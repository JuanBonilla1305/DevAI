# Copia este archivo como .env y rellena lo que necesites.

# --- Obligatorio: el agente no arranca sin esto ---
# Se saca de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Motor de imagen ---
# flux = FLUX.1 Kontext GGUF, mejor parecido, varios minutos por imagen
# sd15 = Stable Diffusion 1.5, mas rapido y peor
MOTOR=flux

# --- Flux ---
# Cuantizacion del transformer. Mas alto = mejor calidad y mas lento.
#   Q3_K_S  ~5.2 GB   si vas muy justo
#   Q4_K_S  ~6.8 GB   recomendado para 6 GB de VRAM
#   Q5_K_M  ~8.4 GB   si tienes mas VRAM o mucha paciencia
# FLUX_ARCHIVO_GGUF=flux1-kontext-dev-Q4_K_S.gguf

# Cuantizar el codificador T5 a 4 bits (de ~9.8 GB a ~3 GB en memoria).
# FLUX_T5_4BIT=1

# Solo hace falta si algun repo pasa a pedir licencia.
# HF_TOKEN=hf_...

# --- Otros ---
# Resolucion de trabajo. Bajala a 512 si te da "CUDA out of memory".
# LADO_MAXIMO=640
# INDICE_CAMARA=0
# MODELO_AGENTE=claude-sonnet-5
